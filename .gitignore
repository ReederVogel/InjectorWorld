# large data files (too big for GitHub). The tiny *.sample.csv fixtures are the
# documented input for `npm run import`, so they stay tracked — without the
# negation below they matched this rule while still being committed, which reads
# as "ignored" but is not.
data/samples/*.csv
!data/samples/*.sample.csv

# GeoNames ZIP download cache. scripts/seed-zips.ts re-downloads US.zip when
# this folder is absent, so committing it just adds megabytes for no benefit.
.tmp-zips/

# Throwaway per-batch import/analysis scripts. They are written for one CSV and
# then deleted; they must never be committed (GitHub push protection has already
# caught a DB password in one).
scripts/tmp-*

# One-off import/scrape artifacts and DB dumps. The data these produced already
# lives in the database; keeping the raw files in git only bloats the repo.
scripts/backup-*.json
data/juvederm-cleaned-2026-06.csv
data/test-combined.csv
data/injectors-world-master.xlsx
